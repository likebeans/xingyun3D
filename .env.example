# ============ 魔珐星云具身驱动 Demo 配置 ============
# 在 https://xingyun3d.com 登录后，于「应用中心」创建驱动应用（选择角色、音色、表演风格），
# 即可获得 App ID 与 App Secret，填入下方两个变量。

XMOV_APP_ID=
XMOV_APP_SECRET=

# 服务网关地址（一般无需修改）
XMOV_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session

# 可选：自定义 Authorization 请求头（无则留空，不发送该头）
XMOV_AUTHORIZATION=

# 本地服务端口
PORT=3000
