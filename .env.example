# ============ 魔珐星云具身驱动 Demo 配置 ============
# 在 https://xingyun3d.com 登录后，于「应用中心」准备支持新版 Agent 的应用，
# 配置可用的 Brain、ASR、TTS、角色与音色，并确认应用有足够额度。
# 获取 App ID 与 App Secret 后，填入下方两个变量。

XMOV_APP_ID=
XMOV_APP_SECRET=

# 新版 Agent 网关（留空时使用此默认地址；服务端会兼容旧版默认网关）
XMOV_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa_v2/session

# 可选：自定义 Authorization 请求头（无则留空，不发送该头）
XMOV_AUTHORIZATION=

# 本地服务端口
PORT=3000
