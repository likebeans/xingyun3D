// GitHub Codespaces 一键开发环境：
// 打开仓库 → Code → Codespaces → 新建 Codespace
// 环境会自动复制 .env.example 为 .env，填入凭证后运行 npm start，点开 3000 端口即可玩。
{
  "name": "星云数字人互动空间",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "forwardPorts": [3000],
  "postCreateCommand": "node -e \"const fs = require('node:fs'); if (!fs.existsSync('.env')) fs.copyFileSync('.env.example', '.env', fs.constants.COPYFILE_EXCL);\"",
  "portsAttributes": {
    "3000": {
      "label": "数字人演示",
      "onAutoForward": "openBrowser"
    }
  }
}
