// GitHub Codespaces 一键开发环境：
// 打开仓库 → Code → Codespaces → 新建 Codespace
// 环境会自动复制 .env.example 为 .env，填入凭证后运行 npm start，点开 3000 端口即可玩。
{
  "name": "星云具身驱动 Demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000],
  "postCreateCommand": "cp -n .env.example .env || true",
  "portsAttributes": {
    "3000": {
      "label": "数字人演示",
      "onAutoForward": "openBrowser"
    }
  }
}
